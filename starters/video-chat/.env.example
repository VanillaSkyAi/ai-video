# Required: plans the response, opening, narration, and suggestions.
ANTHROPIC_API_KEY=

# Optional: generated speech. The browser voice is used when this is empty.
XAI_API_KEY=

# Optional: generated video and server-side speech transcription.
FAL_KEY=

# Optional: stock video and photography for templates and suggestion cards.
PEXELS_API_KEY=

# Optional model overrides. The starter ships with tested defaults.
# ANTHROPIC_PLANNER_MODEL=
# ANTHROPIC_NARRATION_MODEL=
# ANTHROPIC_OPENING_MODEL=
# FAL_VIDEO_MODEL=
