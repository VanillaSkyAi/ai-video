# Server-only. The bundled starter storyboard works without this key.
OPENAI_API_KEY=

# Optional; defaults to gpt-5.4-mini.
OPENAI_PLANNER_MODEL=gpt-5.4-mini

# Optional; defaults to gpt-image-2.
OPENAI_IMAGE_MODEL=gpt-image-2

# Adaptive channel: fixtures are the safe default and spend nothing.
# Set to 1 only when you want the local /channel route to call live providers.
ADAPTIVE_CHANNEL_LIVE_MEDIA=0
# Keep 0 when validating live integration failures. Set 1 only for a forgiving demo.
ADAPTIVE_CHANNEL_ALLOW_FIXTURE_FALLBACK=0

# Optional stock retrieval for /channel. Kept server-side.
PEXELS_API_KEY=

# Optional image and H3 Max video generation for /channel. Kept server-side.
FAL_KEY=
# Optional; defaults to the fast Fal OpenRouter model used to plan five coherent scenes.
FAL_STORY_PLANNER_MODEL=google/gemini-2.5-flash
FAL_IMAGE_MODEL=fal-ai/flux/schnell
FAL_IMAGE_REFERENCE_MODEL=fal-ai/flux-general
FAL_VIDEO_MODEL=minimax/h3-max/text-to-video
FAL_VIDEO_REFERENCE_MODEL=minimax/h3-max/image-to-video
# Measured deployment-specific p95 plus a two-second safety margin decides video eligibility.
FAL_VIDEO_P95_SECONDS=10
